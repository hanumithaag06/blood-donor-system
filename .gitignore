# Virtual environment
venv/

# Python bytecode/cache
__pycache__/
*.pyc

# Environment secrets (keep .env.example, ignore actual .env)
.env

# SQLite database file — generated at runtime by init_db()/seed.py
blood_donor.db
*.db

# Trained ML model artifact — generated by app/ml/train.py, not source code
app/ml/artifacts/*.pkl

# Pytest cache and coverage reports
.pytest_cache/
.coverage
htmlcov/

# Editor/IDE-specific files
.vscode/
.idea/

# OS-specific junk files
.DS_Store
Thumbs.db